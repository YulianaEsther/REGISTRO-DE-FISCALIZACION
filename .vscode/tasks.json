{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Servir aplicación local",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\serve.ps1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Iniciando servidor local",
                    "endsPattern": "Servidor disponible en http://127\\.0\\.0\\.1:8080"
                }
            }
        }
    ]
}
